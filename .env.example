# Copy this file to .env.local and fill in your own values.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Supabase > Project Settings > API > service_role (secret!)
# Server only. Used to mark reservations as paid after PayMongo confirms.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PayMongo > Developers > API keys (use the sk_test_ key while developing)
# Optional. If empty, the Reserve button shows
# "Online payment is not available right now."
PAYMONGO_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Where the app runs. Used for Google login and payment redirects.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional. Password for the demo accounts in lib/demoAccounts.json.
# Create them with: npm run demo:accounts
DEMO_ACCOUNT_PASSWORD=choose-a-long-random-password
